{
  "name": "krona-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "build:demo": "pnpm --filter krona-playground build && node scripts/prerender.mjs",
    "dev": "pnpm --filter krona-playground dev",
    "test": "vitest run --project core",
    "test:watch": "vitest",
    "test:browser": "vitest run --project browser",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "bench": "vitest bench --run --project core",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check-deps": "node scripts/check-deps.mjs",
    "check-names": "node scripts/check-names.mjs",
    "verify": "pnpm lint && pnpm check-names && pnpm check-css && pnpm check-docs && pnpm typecheck && pnpm test:coverage && pnpm build",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:css": "node scripts/build-css.mjs",
    "build:social": "pnpm --filter krona-playground build && node scripts/social-preview.mjs",
    "check-css": "node scripts/build-css.mjs --check",
    "check-docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
