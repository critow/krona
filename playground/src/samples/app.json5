{
  // The edge service, as JSON5: unquoted keys, comments, trailing commas.
  name: 'edge',
  port: 8080,
  limits: {
    body: 0x100000,
    timeout: +1.5e3,
    retries: 3,
  },
  tls: {
    enabled: true,
    ciphers: [
      'TLS_AES_128_GCM_SHA256',
      'TLS_AES_256_GCM_SHA384',
    ],
    /* A hostname with a quote in it is why single quotes are here at all. */
    host: 'edge.example',
  },
  upstreams: [
    { name: 'api', url: 'http://10.0.0.1:9000' },
    { name: 'auth', url: 'http://10.0.0.2:9000' },
  ],
  logging: null,
}
