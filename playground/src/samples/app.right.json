{
  // Krona sample — JSONC is supported: comments survive parsing.
  "name": "krona-demo",
  "version": "1.5.0",
  "private": false,
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "tls": {
      "enabled": true,
      "cert": "/etc/ssl/certs/demo.pem",
      "ciphers": ["TLS_AES_256_GCM_SHA384"]
    },
    "timeouts": { "read": 15, "write": 30, "idle": 120 }
  },
  "database": {
    "driver": "postgres",
    "pool": { "min": 4, "max": 32 },
    "replicas": [
      { "host": "db-1.internal", "weight": 1 },
      { "host": "db-2.internal", "weight": 2 },
      { "host": "db-3.internal", "weight": 2 }
    ]
  },
  "features": { "search": true, "billing": true, "beta": true },
  "telemetry": { "enabled": true, "endpoint": "https://otel.internal:4317" },
  "empty": {},
  "emptyList": []
}
