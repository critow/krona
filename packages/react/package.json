{
  "name": "kronajs",
  "version": "0.3.0",
  "description": "Collapsible tree view, side-by-side diff and in-place editing for JSON, YAML, TOML and INI/.env config files — a React component.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/formats/*",
    "**/index.*"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./json": {
      "import": {
        "types": "./dist/formats/json.d.mts",
        "default": "./dist/formats/json.mjs"
      },
      "require": {
        "types": "./dist/formats/json.d.cts",
        "default": "./dist/formats/json.cjs"
      }
    },
    "./json5": {
      "import": {
        "types": "./dist/formats/json5.d.mts",
        "default": "./dist/formats/json5.mjs"
      },
      "require": {
        "types": "./dist/formats/json5.d.cts",
        "default": "./dist/formats/json5.cjs"
      }
    },
    "./xml": {
      "import": {
        "types": "./dist/formats/xml.d.mts",
        "default": "./dist/formats/xml.mjs"
      },
      "require": {
        "types": "./dist/formats/xml.d.cts",
        "default": "./dist/formats/xml.cjs"
      }
    },
    "./hcl": {
      "import": {
        "types": "./dist/formats/hcl.d.mts",
        "default": "./dist/formats/hcl.mjs"
      },
      "require": {
        "types": "./dist/formats/hcl.d.cts",
        "default": "./dist/formats/hcl.cjs"
      }
    },
    "./properties": {
      "import": {
        "types": "./dist/formats/properties.d.mts",
        "default": "./dist/formats/properties.mjs"
      },
      "require": {
        "types": "./dist/formats/properties.d.cts",
        "default": "./dist/formats/properties.cjs"
      }
    },
    "./yaml": {
      "import": {
        "types": "./dist/formats/yaml.d.mts",
        "default": "./dist/formats/yaml.mjs"
      },
      "require": {
        "types": "./dist/formats/yaml.d.cts",
        "default": "./dist/formats/yaml.cjs"
      }
    },
    "./toml": {
      "import": {
        "types": "./dist/formats/toml.d.mts",
        "default": "./dist/formats/toml.mjs"
      },
      "require": {
        "types": "./dist/formats/toml.d.cts",
        "default": "./dist/formats/toml.cjs"
      }
    },
    "./ini": {
      "import": {
        "types": "./dist/formats/ini.d.mts",
        "default": "./dist/formats/ini.mjs"
      },
      "require": {
        "types": "./dist/formats/ini.d.cts",
        "default": "./dist/formats/ini.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "node ../../scripts/build-css.mjs && tsdown",
    "prepublishOnly": "pnpm build && publint && attw --pack . --profile node16 --exclude-entrypoints styles.css"
  },
  "dependencies": {
    "@kronajs/core": "workspace:*",
    "@tanstack/react-virtual": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "homepage": "https://critow.github.io/krona/",
  "bugs": {
    "url": "https://github.com/critow/krona/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/critow/krona.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "json-viewer",
    "yaml",
    "toml",
    "ini",
    "diff",
    "side-by-side",
    "code-folding",
    "config",
    "configuration",
    "jsonc",
    "json5",
    "xml",
    "hcl",
    "terraform",
    "properties",
    "dotenv",
    "tree-view",
    "editor",
    "typescript",
    "json",
    "viewer",
    "diff-viewer",
    "json-diff",
    "yaml-diff",
    "collapsible"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
