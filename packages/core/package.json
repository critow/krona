{
  "name": "@kronajs/core",
  "version": "0.3.0",
  "description": "Framework-agnostic core behind kronajs: a line-based document model for JSON, YAML, TOML and INI/.env, with folding ranges and a line diff.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/formats/*",
    "**/index.*"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./json": {
      "import": {
        "types": "./dist/formats/json.d.mts",
        "default": "./dist/formats/json.mjs"
      },
      "require": {
        "types": "./dist/formats/json.d.cts",
        "default": "./dist/formats/json.cjs"
      }
    },
    "./json5": {
      "import": {
        "types": "./dist/formats/json5.d.mts",
        "default": "./dist/formats/json5.mjs"
      },
      "require": {
        "types": "./dist/formats/json5.d.cts",
        "default": "./dist/formats/json5.cjs"
      }
    },
    "./xml": {
      "import": {
        "types": "./dist/formats/xml.d.mts",
        "default": "./dist/formats/xml.mjs"
      },
      "require": {
        "types": "./dist/formats/xml.d.cts",
        "default": "./dist/formats/xml.cjs"
      }
    },
    "./hcl": {
      "import": {
        "types": "./dist/formats/hcl.d.mts",
        "default": "./dist/formats/hcl.mjs"
      },
      "require": {
        "types": "./dist/formats/hcl.d.cts",
        "default": "./dist/formats/hcl.cjs"
      }
    },
    "./properties": {
      "import": {
        "types": "./dist/formats/properties.d.mts",
        "default": "./dist/formats/properties.mjs"
      },
      "require": {
        "types": "./dist/formats/properties.d.cts",
        "default": "./dist/formats/properties.cjs"
      }
    },
    "./yaml": {
      "import": {
        "types": "./dist/formats/yaml.d.mts",
        "default": "./dist/formats/yaml.mjs"
      },
      "require": {
        "types": "./dist/formats/yaml.d.cts",
        "default": "./dist/formats/yaml.cjs"
      }
    },
    "./toml": {
      "import": {
        "types": "./dist/formats/toml.d.mts",
        "default": "./dist/formats/toml.mjs"
      },
      "require": {
        "types": "./dist/formats/toml.d.cts",
        "default": "./dist/formats/toml.cjs"
      }
    },
    "./ini": {
      "import": {
        "types": "./dist/formats/ini.d.mts",
        "default": "./dist/formats/ini.mjs"
      },
      "require": {
        "types": "./dist/formats/ini.d.cts",
        "default": "./dist/formats/ini.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build && publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "diff": "catalog:",
    "jsonc-parser": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "homepage": "https://critow.github.io/krona/",
  "bugs": {
    "url": "https://github.com/critow/krona/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/critow/krona.git",
    "directory": "packages/core"
  },
  "keywords": [
    "json",
    "yaml",
    "toml",
    "ini",
    "diff",
    "viewer",
    "folding",
    "config",
    "configuration",
    "jsonc",
    "json5",
    "xml",
    "hcl",
    "terraform",
    "properties",
    "dotenv",
    "code-folding",
    "typescript"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
