{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@kronajs/core": ["./packages/core/src/index.ts"],
      "@kronajs/core/*": ["./packages/core/src/formats/*.ts"],
      "kronajs": ["./packages/react/src/index.ts"],
      "kronajs/*": ["./packages/react/src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/*/src/**/*",
    "playground/src/**/*",
    "playground/*.ts",
    "packages/*/*.ts",
    "*.ts",
    "scripts/**/*",
    "e2e/**/*"
  ]
}
